# # Supabase
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# # Database (Supabase Postgres connection strings)
# DATABASE_URL=your_postgres_connection_string
# DIRECT_URL=your_direct_postgres_connection_string

# # Admin Panel — KEEP THIS SECRET
# ADMIN_PANEL_PASSWORD=your_admin_password_here
# ADMIN_SESSION_SALT=generate_random_32char_string

# # HeyReach LinkedIn Automation
# HEYREACH_API_KEY=your_heyreach_api_key_here

# # AI Provider (used as fallback if Admin Panel not configured)
# # Options: OPENROUTER | GEMINI | OPENAI
# AI_PROVIDER=OPENROUTER
# AI_API_KEY=your_ai_api_key_here
# AI_MODEL=google/gemini-flash-1.5
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# # Email (Resend)
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=outreach@yourdomain.com
