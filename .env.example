# ---------------------------------------------------------------------------
# vGTM — copy this file to .env.local and fill in the values you need.
# Only Supabase + Database are strictly required to boot the app.
# ---------------------------------------------------------------------------

# # Supabase (auth). Skip these locally and set NEXT_PUBLIC_BYPASS_SETUP=true.
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# # Database (Supabase Postgres connection strings) — REQUIRED
# DATABASE_URL=your_postgres_connection_string
# DIRECT_URL=your_direct_postgres_connection_string

# # Local / preview only. Skips login and auto-creates a workspace.
# # Ignored (refused) when NODE_ENV=production.
# NEXT_PUBLIC_BYPASS_SETUP=true

# # Admin Panel — KEEP THIS SECRET
# ADMIN_PANEL_PASSWORD=your_admin_password_here
# ADMIN_SESSION_SALT=generate_random_32char_string

# ---------------------------------------------------------------------------
# AI message engine (connection notes, follow-ups, emails)
# Fallback if the Admin Panel is not configured.
# Options: OPENROUTER | GEMINI | OPENAI
#
# Free options (no card needed):
#   GEMINI     + gemini-2.0-flash                    <- free tier, best default
#   OPENROUTER + google/gemini-2.0-flash-exp:free    <- free, rate limited
#   OPENROUTER + meta-llama/llama-3.3-70b-instruct:free
# Leave AI_MODEL empty to use the provider default from lib/ai/providers.ts.
# ---------------------------------------------------------------------------
# AI_PROVIDER=GEMINI
# AI_API_KEY=your_ai_api_key_here
# AI_MODEL=gemini-2.0-flash
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# # Email (Resend) — only needed if your sequences have EMAIL steps
# RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=outreach@yourdomain.com
# RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret_here

# # Sequence automation cron (protects /api/cron/process-sequences)
# # Vercel sends this automatically as "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=generate_random_32char_string

# # OPTIONAL — not used by the Send Queue. LinkedIn sending is human-in-the-loop:
# # the app drafts, you send in LinkedIn yourself, then log it back.
# # HEYREACH_API_KEY=your_heyreach_api_key_here
